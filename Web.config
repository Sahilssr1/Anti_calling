<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Local PostgreSQL for the Sanjivani call log (db/schema.sql).
         Currently unwired — kept for later. See Web.config.sample. -->
    <add name="SanjivaniPg"
         connectionString="Host=localhost;Port=5432;Database=sanjivani_calls;Username=postgres;Password=postgres"
         providerName="Npgsql" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
